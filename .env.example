# =============================================================================
# Household Finance — environment variables
# Copy to .env.local for development. Never commit a real .env file.
# =============================================================================

# Database — Neon (or any Postgres). DIRECT_URL is the unpooled connection
# used by `prisma migrate`; DATABASE_URL is the pooled connection used at
# runtime. On non-pooled hosts both can point to the same URL.
DATABASE_URL="postgresql://user:password@host:5432/household_finance?schema=public"
DIRECT_URL="postgresql://user:password@host:5432/household_finance?schema=public"

# Auth.js (NextAuth v5). Generate AUTH_SECRET with: openssl rand -base64 32
AUTH_SECRET=""
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
AUTH_TRUST_HOST="true"

# Application-level field encryption. 32 random bytes, base64-encoded.
# Generate with: openssl rand -base64 32
# WARNING: rotating this key requires re-encrypting all *Encrypted columns.
FIELD_ENCRYPTION_KEY=""

# Bootstrap: this email becomes the first Admin allow-list entry on `npm run
# prisma:seed`. Subsequent sign-ins must be invited from the Admin UI.
ADMIN_BOOTSTRAP_EMAIL=""

# App
APP_BASE_URL="http://localhost:3000"
NODE_ENV="development"

# Currency & FX
BASE_CURRENCY="CHF"
TRACKED_CURRENCIES="CHF,BRL,USD,EUR"
FX_PROVIDER_PRIMARY="exchangerate-host"
FX_PROVIDER_FALLBACK="frankfurter"

# Protects the daily FX cron endpoint. Generate with: openssl rand -hex 32
CRON_SHARED_SECRET=""
